{
  "name": "spcase-frontend",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "build": "npm run build:css && npm run build:js",
    "build:css": "tailwindcss -i ./web/src/input.css -o ./web/static/css/app.css --minify",
    "build:js": "esbuild ./web/src/app.js --bundle --minify --outfile=./web/static/js/app.js",
    "watch:css": "tailwindcss -i ./web/src/input.css -o ./web/static/css/app.css --watch",
    "watch:js": "esbuild ./web/src/app.js --bundle --outfile=./web/static/js/app.js --watch"
  },
  "dependencies": {
    "alpinejs": "3.14.9",
    "gsap": "3.15.0",
    "lenis": "1.3.25"
  },
  "devDependencies": {
    "esbuild": "0.25.6",
    "tailwindcss": "3.4.17"
  }
}
