# Isolated local staging stack.
SPCASE_APP_IMAGE=spcase:staging
SPCASE_MIGRATOR_IMAGE=spcase-migrator:staging
SPCASE_NGINX_IMAGE=spcase-nginx:staging
NGINX_PORT=18080
STAGING_DB_PORT=15432

# Application configuration.
PORT=8000
APP_DOMAIN=staging.spcase.ru
CORS_ALLOWED_ORIGINS=https://staging.spcase.ru
REGISTRATION_DEADLINE=2026-10-15T18:00:00Z
SUBMISSION_DEADLINE=2026-10-17T21:00:00Z
NO_TEAM_TELEGRAM_URL=https://t.me/example_team_search

# Isolated PostgreSQL.
DB_HOST=db
DB_PORT=5432
POSTGRES_ADMIN_PASSWORD=
DB_MIGRATOR_USER=spcase_migrator
DB_MIGRATOR_PASSWORD=
DB_APP_USER=spcase_app
DB_APP_PASSWORD=

# Transitional rollback/direct-process compatibility only. Normal Compose does
# not consume these values for app or admin-bootstrap.
DB_USER=
DB_PASSWORD=
DB_NAME=spcase_staging
DB_STATEMENT_TIMEOUT=15s
DB_LOCK_TIMEOUT=5s

# Host-side integration tests against this disposable staging database.
# SPCASE_TEST_MIGRATOR_DATABASE_URL=postgres://spcase_migrator:<password>@127.0.0.1:15432/spcase_staging?sslmode=disable
# SPCASE_TEST_APP_DATABASE_URL=postgres://spcase_app:<password>@127.0.0.1:15432/spcase_staging?sslmode=disable

# Generate independently with: openssl rand -base64 48
JWT_SECRET=
JURY_REGISTRATION_KEY=
