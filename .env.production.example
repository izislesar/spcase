# Compose images and application environment file.
SPCASE_APP_IMAGE=spcase:production
SPCASE_MIGRATOR_IMAGE=spcase-migrator:production
SPCASE_NGINX_IMAGE=spcase-nginx:production
NGINX_PORT=8080

# Domain and server configuration.
PORT=8000
APP_DOMAIN=spcase.ru
CORS_ALLOWED_ORIGINS=https://spcase.ru,https://www.spcase.ru
REGISTRATION_DEADLINE=2026-10-15T18:00:00Z
SUBMISSION_DEADLINE=2026-10-17T21:00:00Z
NO_TEAM_TELEGRAM_URL=https://t.me/example_team_search

# PostgreSQL. Generate a URL-safe password with: openssl rand -hex 32
DB_HOST=db
DB_PORT=5432
POSTGRES_ADMIN_PASSWORD=
DB_MIGRATOR_USER=spcase_migrator
DB_MIGRATOR_PASSWORD=
DB_APP_USER=spcase_app
DB_APP_PASSWORD=

# Transitional rollback/direct-process compatibility only. Normal Compose does
# not consume these values for app or admin-bootstrap.
DB_USER=
DB_PASSWORD=
DB_NAME=spcase
DB_STATEMENT_TIMEOUT=15s
DB_LOCK_TIMEOUT=5s

# Generate each secret independently with: openssl rand -base64 48
JWT_SECRET=
JURY_REGISTRATION_KEY=
