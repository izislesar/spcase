# Domain & Server Config
PORT=8000
APP_DOMAIN=spcase.ru
CORS_ALLOWED_ORIGINS=https://spcase.ru,https://www.spcase.ru
REGISTRATION_DEADLINE=2026-10-15T18:00:00Z
SUBMISSION_DEADLINE=2026-10-17T21:00:00Z
NO_TEAM_TELEGRAM_URL=https://t.me/example_team_search

# DB Config
DB_HOST=127.0.0.1
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=spcase_db
# PostgreSQL-native per-statement and lock-wait limits.
DB_STATEMENT_TIMEOUT=15s
DB_LOCK_TIMEOUT=5s

# JWT Config
# Generate independently with: openssl rand -base64 48
JWT_SECRET=

# Jury Registration
# Generate independently with: openssl rand -base64 48
JURY_REGISTRATION_KEY=
