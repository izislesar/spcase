# Domain & Server Config
PORT=8000
APP_DOMAIN=spcase.ru
CORS_ALLOWED_ORIGINS=https://spcase.ru,https://www.spcase.ru
REGISTRATION_DEADLINE=2026-10-15T18:00:00Z
SUBMISSION_DEADLINE=2026-10-17T21:00:00Z
NO_TEAM_TELEGRAM_URL=https://t.me/example_team_search

# DB Config
DB_HOST=127.0.0.1
DB_PORT=5432
# Cluster bootstrap administrator. Generate with: openssl rand -hex 32
POSTGRES_ADMIN_PASSWORD=
DB_MIGRATOR_USER=spcase_migrator
DB_MIGRATOR_PASSWORD=
DB_APP_USER=spcase_app
DB_APP_PASSWORD=

# Direct-process and transitional rollback compatibility only. Normal Compose
# maps DB_APP_* into the DB_USER/DB_PASSWORD interface consumed by Go binaries.
DB_USER=spcase_app
# For direct application/admin-bootstrap execution, use DB_APP_PASSWORD.
DB_PASSWORD=
DB_NAME=spcase_db
# PostgreSQL-native per-statement and lock-wait limits.
DB_STATEMENT_TIMEOUT=15s
DB_LOCK_TIMEOUT=5s

# Integration tests require both roles and must target a disposable migrated database.
# SPCASE_TEST_MIGRATOR_DATABASE_URL=postgres://spcase_migrator:<password>@127.0.0.1:5432/spcase_test?sslmode=disable
# SPCASE_TEST_APP_DATABASE_URL=postgres://spcase_app:<password>@127.0.0.1:5432/spcase_test?sslmode=disable

# JWT Config
# Generate independently with: openssl rand -base64 48
JWT_SECRET=

# Jury Registration
# Generate independently with: openssl rand -base64 48
JURY_REGISTRATION_KEY=
